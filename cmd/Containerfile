# podman run -it -v $(pwd):/workspace:Z --rm codeberg.org/aur0ra/cage:latest

# Pin to a specific tag instead of latest to prevent supply chain attacks
FROM docker.io/nixos/nix:2.32.8

# Copy shell.nix read-only so it can't be tampered with at runtime
COPY shell.nix /shell.nix

ENV NIXPKGS_ALLOW_UNFREE=1

# Pre-fetch all nix-shell dependencies at build time —
# the running container needs no outbound access to nixpkgs
RUN nix-shell /shell.nix --run "echo deps ok"

WORKDIR /home
WORKDIR /workspace

# Explicit, minimal environment — avoids leaking host vars
ENV NIX_PATH=nixpkgs=/nix/var/nix/profiles/per-user/root/channels/nixpkgs

ENTRYPOINT ["nix-shell", "/shell.nix"]