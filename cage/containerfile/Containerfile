FROM debian:stable-slim

ENV NIXPKGS_ALLOW_UNFREE=1

RUN apt-get update && apt-get install -y curl xz-utils && rm -rf /var/lib/apt/lists/*

RUN groupadd -r nixbld && \
    for i in $(seq 1 10); do useradd -r -g nixbld -G nixbld -d /var/empty -s /sbin/nologin nixbld$i; done && \
    useradd -m -d /home/cage -s /bin/sh cage && \
    mkdir -m 0755 /nix && chown cage /nix

USER cage

RUN curl -L https://nixos.org/nix/install | sh -s -- --no-daemon

ENV PATH=/home/cage/.nix-profile/bin:$PATH
ENV NIX_PATH=nixpkgs=/home/cage/.nix-defexpr/channels/nixpkgs

COPY --chown=cage shell.nix /shell.nix

RUN . /home/cage/.nix-profile/etc/profile.d/nix.sh && nix-shell /shell.nix --run "echo deps ok"

WORKDIR /workspace

ENTRYPOINT ["/bin/sh", "-c", ". /home/cage/.nix-profile/etc/profile.d/nix.sh && nix-shell /shell.nix --command \"claude\""]
